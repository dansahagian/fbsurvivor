#!/bin/bash
# Used to deploy on server

set -euo pipefail

umask 027
export UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_LINK_MODE=copy

echo "\nInstalling Dependencies...\n"
cd /opt/fbsurvivor

# rsync copies the Mac's modes (world-readable). Reset what it just pushed:
# group fbsurvivor can read, nobody else can, directories stay setgid.
SYNCED=(fbsurvivor pyproject.toml uv.lock manage.py deploy uploads)
chgrp -R web "${SYNCED[@]}"
chmod -R u+rwX,g+rX,g-w,o-rwx "${SYNCED[@]}"
find "${SYNCED[@]}" -type d -exec chmod g+s {} +

/root/.local/bin/uv sync --no-dev

# uv runs as root under umask 027, so the venv and interpreter come out root:root.
# The service user reads them through group web.
chgrp -R web .venv /opt/uv-python
chmod -R g+rX,g-w,o-rwx .venv /opt/uv-python

trap 'sudo systemctl start fbsurvivor.service' EXIT

echo "\nStopping services...\n"
sudo systemctl stop fbsurvivor.service

/root/.local/bin/uv run --no-dev python manage.py migrate
/root/.local/bin/uv run --no-dev python manage.py createcachetable

# Static files go to /srv/www and nginx has to read them, so they need the normal umask.
(umask 022; /root/.local/bin/uv run --no-dev python manage.py collectstatic --clear --no-input)
/root/.local/bin/uv run --no-dev python manage.py check --deploy

echo "\nStarting services...\n"
sudo systemctl start fbsurvivor.service

trap - EXIT

sleep 2
