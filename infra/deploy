#!/bin/zsh
# Used to deploy on server

set -euo pipefail

umask 027
export UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_LINK_MODE=copy

echo "\nInstalling Dependencies...\n"
cd /opt/fbsurvivor

# rsync copies the Mac's modes (world-readable). Reset what it just pushed:
# group fbsurvivor can read, nobody else can, directories stay setgid.
SYNCED=(fbsurvivor pyproject.toml uv.lock manage.py deploy uploads)
chgrp -R fbsurvivor $SYNCED
chmod -R u+rwX,g+rX,g-w,o-rwx $SYNCED
find $SYNCED -type d -exec chmod g+s {} +

/home/dan/.cargo/bin/uv sync --no-dev

trap 'sudo systemctl start wsgi-server-fbsurvivor.service' EXIT

echo "\nStopping services...\n"
sudo systemctl stop wsgi-server-fbsurvivor.service

/home/dan/.cargo/bin/uv run --no-dev python manage.py migrate
/home/dan/.cargo/bin/uv run --no-dev python manage.py createcachetable

# Static files go to /srv/www and nginx has to read them, so they need the normal umask.
(umask 022; /home/dan/.cargo/bin/uv run --no-dev python manage.py collectstatic --clear --no-input)
/home/dan/.cargo/bin/uv run --no-dev python manage.py check --deploy

echo "\nStarting services...\n"
sudo systemctl start wsgi-server-fbsurvivor.service

trap - EXIT

sleep 2
