#!/usr/bin/env sh

DB_FILE=/tmp/fbsurvivor_dump

# Guard: only run on the production server and if the file exists
[ "$(hostname -s)" = "onryo" ] || { echo "Failed: Not onryo"; exit 1; }
[ -s "$DB_FILE" ] || { echo "Failed: $DB_FILE missing or empty" >&2; exit 1; }

psql -U postgres -d postgres -c "DROP DATABASE IF EXISTS fbsurvivor2;"
psql -U postgres -d postgres -c "DROP ROLE IF EXISTS fbsurvivor2;"
psql -U postgres -d postgres -c "CREATE DATABASE fbsurvivor2;"
psql -U postgres -d postgres -c "CREATE ROLE fbsurvivor2 WITH PASSWORD 'password';"
psql -U postgres -d postgres -c "ALTER ROLE fbsurvivor2 WITH CREATEDB LOGIN;"
psql -U postgres -d postgres -c "GRANT ALL ON DATABASE fbsurvivor2 TO fbsurvivor2;"
psql -U postgres -d fbsurvivor2 -c "DROP SCHEMA IF EXISTS public;"
psql -U postgres -d fbsurvivor2 -c "CREATE SCHEMA public AUTHORIZATION fbsurvivor2;"
psql -U postgres -v ON_ERROR_STOP=1 fbsurvivor2 < "$DB_FILE"
