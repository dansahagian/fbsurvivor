export DJANGO_SETTINGS_MODULE=fbsurvivor.settings

# deploy
alias deploy="./scripts/deploy"
alias upgrade="./scripts/upgrade"

# checks
alias check="./scripts/checks/check"
alias format="./scripts/checks/format"
alias lint="./scripts/checks/lint"
alias test="./scripts/checks/test"
alias types="./scripts/checks/types"

# management commands
alias runserver="uv run python manage.py runserver 0.0.0.0:8000"
alias shell_plus="uv run python manage.py shell_plus"
alias showmigrations="uv run python manage.py showmigrations"
alias makemigrations="uv run python manage.py makemigrations"
alias migrate="uv run python manage.py migrate"
