SETTINGS=fbsurvivor.settings

# checks
alias check="./bin/checks/check"
alias audit="./bin/checks/audit"
alias format="./bin/checks/format"
alias lint="./bin/checks/lint"
alias types="./bin/checks/types"

# dev
alias init-env="./bin/dev/init-env"
alias upgrade="./bin/deploy/upgrade"

# management commands
alias runserver="DJANGO_SETTINGS_MODULE=$SETTINGS uv run python manage.py runserver 0.0.0.0:8000"
alias shell_plus="DJANGO_SETTINGS_MODULE=$SETTINGS uv run python manage.py shell_plus"
alias showmigrations="DJANGO_SETTINGS_MODULE=$SETTINGS uv run python manage.py showmigrations"
alias makemigrations="DJANGO_SETTINGS_MODULE=$SETTINGS uv run python manage.py makemigrations"
alias migrate="DJANGO_SETTINGS_MODULE=$SETTINGS uv run python manage.py migrate"
