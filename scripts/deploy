#!/usr/bin/env sh

set -e

./scripts/checks/check

echo "\nDeploying...\n"

rsync -a ./fbsurvivor dan@ran:/opt/fbsurvivor
rsync -a ./pyproject.toml dan@ran:/opt/fbsurvivor
rsync -a ./uv.lock dan@ran:/opt/fbsurvivor
rsync -a ./manage.py dan@ran:/opt/fbsurvivor
rsync -a ./infra/deploy dan@ran:/opt/fbsurvivor
rsync -a ./uploads dan@ran:/opt/fbsurvivor

ssh ran /opt/fbsurvivor/deploy

curl -X GET -I https://fbsurvivor.com
